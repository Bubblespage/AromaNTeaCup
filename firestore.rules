rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // DEBUG: Temporarily return true if authenticated to isolate the issue
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      // 1. Admin can read, update, and delete all orders
      allow read, update, delete: if isAdmin();
      
      // 2. Authenticated users can read their own orders
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // 3. Guests can only fetch a specific order by ID (cannot list all)
      allow get: if !isAuthenticated() && resource.data.userId == null;
                 
      // 4. Anyone can create an order
      allow create: if true;
    }
  }
}
