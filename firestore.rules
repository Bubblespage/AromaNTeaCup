rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      // Use matches with regex to allow for case-insensitivity or trailing spaces 
      // in case the admin account was created with a typo.
      return request.auth != null && 
             request.auth.token.email != null && 
             request.auth.token.email.matches('(?i)^\\s*admin@aroma\\.com\\s*$');
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin(); 
    }

    match /users/{userId} {
      allow read: if isAdmin();
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      // 1. Admin can read, update, and delete all orders
      allow read, write: if isAdmin();
      
      // 2. Anyone can create an order (guests placing orders)
      allow create: if true;
    }
  }
}
